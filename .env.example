# ── Super-admin database (Neon "Admin" DB) ─────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/Admin?sslmode=require"

# ── Neon project (cafe databases are created INSIDE this project via SQL) ──
# Shown as a console link in Settings. Found in .neon of the QR-Ordering repo.
NEON_PROJECT_ID="square-shadow-18088269"

# ── Security ──────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of tenant connection strings
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# Secret for signing session JWTs
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# ── App ───────────────────────────────────────────────────────────────
# Base URL of the customer-facing QR ordering app (used to build cafe URLs)
CLIENT_APP_URL="https://order.yourdomain.com"
